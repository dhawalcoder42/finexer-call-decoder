# Gemini (free key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=paste_your_gemini_key_here

# Any long random string, used to sign login sessions.
# Example: run in terminal ->  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=paste_a_long_random_string_here

# The admin account (you). First login uses ADMIN_PASSWORD, then it is stored securely.
ADMIN_EMAIL=you@finexer.com
ADMIN_PASSWORD=choose_a_strong_password

# Supabase project (free tier). Project Settings -> API in the Supabase dashboard.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=paste_the_service_role_key_here
